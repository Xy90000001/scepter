{
  "name": "scejs",
  "version": "1.3.1",
  "description": "Multipurpose Javascript 3D graphic library",
  "repository": {
    "type": "git",
    "url": "https://github.com/stormcolor/SCEJS.git"
  },
  "dependencies": {
    "webclgl": "4.1.26",
    "nclgl": "1.3.1",
    "draggabilly": "2.2.0"
  },
  "devDependencies": {
    "babel-plugin-syntax-async-functions": "~6.13.0",
    "babel-plugin-transform-regenerator": "~6.26.0",
    "babel-preset-es2015": "~6.24.1",
    "babelify": "~7.3.0",
    "uglify-js": "~3.0.28",
    "watchify": "~3.9.0",
    "browserify": "~16.1.1"
  },
  "main": "dist/scejs/SCEJS.min.js",
  "scripts": {
    "build_&_watch": "node build.js -b -s",
    "build_&_deploy": "node build.js -db && node build.js -d=dist/scejs/SCEJS.min.js"
  },
  "license": "MIT"
}
