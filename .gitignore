# ── OS cruft ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── System-specific / transient ───────────────────────────
nohup.out
*.log
*.out
*.pid
*.tmp
.cache/
.vault_sync.log
.vault_watch.log
graphify-out/

# ── Node / JS tooling ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# ── Obsidian device-local state (plugin CONFIGS stay tracked) ──
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/obsidian-git/data.json

# ── Secrets — never, ever commit these ────────────────────
*.env
.env*
auth.json
*.token
*.pem
*id_rsa*
*id_ed25519*

# ── Raw session DBs / dumps (only markdown digests travel) ──
*.db
*.db-*
*.sqlite*
*.jsonl
*.jsonl.gz

# ── Termux/Android noise ───────────────────────────────────
.nomedia

# Lock files
*.lock
