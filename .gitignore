# ── OS cruft ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── System-specific / transient ───────────────────────────
nohup.out
*.log
*.out
*.pid
*.tmp
.cache/
.vault_sync.log
.vault_watch.log
graphify-out

# ── Node / JS tooling ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# ── Generated / build artifacts (rebuilt locally, never sync) ──
bin/
dist/
build/
*.tsbuildinfo

# ── Obsidian device-local state (plugin CONFIGS stay tracked) ──
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/obsidian-git/data.json

# ── Secrets — never, ever commit these ────────────────────
*.env
.env*
auth.json
*.token
*.pem
*id_rsa*
*id_ed25519*

# ── Raw session DBs / dumps (only markdown digests travel) ──
*.db
*.db-*
*.sqlite*
*.jsonl
*.jsonl.gz

# ── Termux/Android noise ───────────────────────────────────
.nomedia

# Lock files
*.lock

# ── Runtime caches (modified by live agents, never sync) ──
Hermes/runtime/
Hermes/Profiles/*/cache/
Hermes/Profiles/*/context_length_cache.yaml
Hermes/Profiles/*/local_endpoint_probes.json
Hermes/Profiles/*/models_dev_cache.json
Hermes/Profiles/*/ollama_cloud_models_cache.json
Hermes/Profiles/*/provider_models_cache.json
Hermes/Profiles/*/.skills_prompt_snapshot.json
Hermes/Profiles/*/.update_check
Hermes/Profiles/*/skills/.bundled_manifest
Hermes/Profiles/*/skills/.curator_state
Hermes/Profiles/*/skills/.termux_bundled_sync_stamp
Hermes/Profiles/*/.hermes_history

# ── Vault Profile Scope (Lean Vault Isolation Protocol) ──
# ONLY heromi/ and xosin/ are tracked in vault
# All PC-only profiles (xorin, ceo, engineer, product, growth, finance, ops, agency-*) are LOCAL ONLY
Hermes/Profiles/xorin/
Hermes/Profiles/ceo/
Hermes/Profiles/engineer/
Hermes/Profiles/product/
Hermes/Profiles/growth/
Hermes/Profiles/finance/
Hermes/Profiles/ops/
Hermes/Profiles/agency-*/

# ── Session Scope: ONLY heromi sessions sync ──
Hermes/Sessions/xorin/
Hermes/Sessions/xosin/
Hermes/Sessions/ceo/
Hermes/Sessions/engineer/
Hermes/Sessions/product/
Hermes/Sessions/growth/
Hermes/Sessions/finance/
Hermes/Sessions/ops/
Hermes/Sessions/agency-*/
